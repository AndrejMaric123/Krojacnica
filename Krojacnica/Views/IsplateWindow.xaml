<Window x:Class="Krojacnica.Views.IsplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource IsplateWindow_Title}"
        Height="600" Width="880"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Storyboard x:Key="WindowEnterAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Grid Background="{DynamicResource AppGradientBrush}">

        <!-- CARD -->
        <Border x:Name="CardBorder"
                Style="{DynamicResource AppCardStyle}"
                Width="812"
                Height="500"
                VerticalAlignment="Top"
                HorizontalAlignment="Center" Margin="0,22,0,0">

            <StackPanel>

                <!-- NASLOV -->
                <TextBlock Text="{DynamicResource IsplateWindow_Title}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                
                <!-- Nema isplata -->
<TextBlock x:Name="txtNemaIsplata"
           Text="Nema unesenih isplata."
           Foreground="Gray"
           FontStyle="Italic"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Margin="0,0,0,10"
           Visibility="Collapsed"/>


                <!-- DataGrid -->
                <DataGrid x:Name="dgIsplate"
                          ItemsSource="{Binding Isplate}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Style="{DynamicResource DataGridBase}"
                          ColumnHeaderStyle="{DynamicResource DataGridHeader}"
                          RowStyle="{DynamicResource DataGridRow}"
                          Margin="0,0,0,10"
                          MinHeight="250">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource IsplateWindow_ColBrojIsplate}"
                                            Binding="{Binding BrojIsplate}" Width="*"
                                            ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource IsplateWindow_ColDatum}"
                                            Binding="{Binding Datum}" Width="*"
                                            ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource IsplateWindow_ColIznos}"
                                            Binding="{Binding Iznos, StringFormat=N2}" Width="*"
                                            ElementStyle="{DynamicResource CenterCell}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Dodavanje nove isplate -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource IsplateWindow_LabelIznos}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtIznos"
                             Width="120" Height="50" Margin="0,0,5,0"
                             Style="{DynamicResource AppTextBoxStyle}"
                             materialDesign:HintAssist.Hint="{DynamicResource IsplateWindow_HintIznos}"/>
                    <Button Style="{DynamicResource AppPrimaryButtonStyle}"
                            Width="134" Height="50"
                            Click="DodajIsplatu_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,6,0" Foreground="White"/>
                            <TextBlock Text="{DynamicResource IsplateWindow_ButtonDodajIsplatu}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Ukupno i preostalo -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <TextBlock Text="{DynamicResource IsplateWindow_TextUkupno}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtUkupnoIsplaceno" Text="0.00" Margin="5,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource IsplateWindow_TextPreostalo}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPreostaloZaIsplatu" Text="0.00" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,25"
                                 MessageQueue="{Binding SnackbarQueue}"
                                 Width="450"/>
    </Grid>
</Window>
