<Window x:Class="Krojacnica.Views.AddOrEditMaterijalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource AddEditMaterial_Title}"
        Height="380" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Background="{DynamicResource AppGradientBrush}">

        <!-- Card panel -->
        <Border x:Name="CardBorder"
                Style="{DynamicResource AppCardStyle}"
                Width="380"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,11,0,0">
            <StackPanel HorizontalAlignment="Center" Width="300">

                <!-- Naslov -->
                <TextBlock Text="{DynamicResource AddEditMaterial_Header}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Naziv materijala -->
                <TextBox x:Name="txtNaziv"
                         Style="{DynamicResource AppTextBoxStyle}"
                         materialDesign:HintAssist.Hint="{DynamicResource Hint_MaterialName}"
                         materialDesign:HintAssist.Foreground="{DynamicResource AppTextBoxHintBrush}"
                         BorderBrush="{DynamicResource AppTextBoxBorderBrush}"
                         Height="50" Margin="0,5"/>

                <!-- Kvalitet materijala -->
                <TextBox x:Name="txtKvalitet"
                         Style="{DynamicResource AppTextBoxStyle}"
                         materialDesign:HintAssist.Hint="{DynamicResource Hint_MaterialQuality}"
                         materialDesign:HintAssist.Foreground="{DynamicResource AppTextBoxHintBrush}"
                         BorderBrush="{DynamicResource AppTextBoxBorderBrush}"
                         Height="50" Margin="0,5"/>

                <!-- Dugmad Sačuvaj / Otkaži -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="{DynamicResource Btn_SaveMaterial}"
                            Width="110" Margin="0,0,10,0"
                            Style="{DynamicResource AppPrimaryButtonStyle}" Click="Save_Click"/>
                    <Button Content="{DynamicResource Btn_CancelMaterial}"
                            Width="110"
                            Style="{DynamicResource AppPrimaryButtonStyle}" Click="Cancel_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 MessageQueue="{Binding SnackbarMessageQueue}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="300"/>
    </Grid>
</Window>
