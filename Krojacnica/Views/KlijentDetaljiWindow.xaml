<Window x:Class="Krojacnica.Views.KlijentDetaljiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource KlijentDetaljiWindow_Title}"
        Width="1100" Height="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">

    <Grid Background="{DynamicResource AppGradientBrush}">

        <!-- CARD -->
        <Border Style="{DynamicResource AppCardStyle}"
                Width="1002" Height="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,12,0,0">

            <DockPanel>

                <!-- HEADER -->
                <TextBlock Text="{DynamicResource KlijentDetaljiWindow_Title}"
                           FontSize="30"
                           Name="txtHeader"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           Margin="0 0 0 20"
                           HorizontalAlignment="Center"
                           DockPanel.Dock="Top"/>

                <!-- TAB CONTROL -->
                <TabControl FontSize="16" Margin="0,10,0,0">

                    <!-- NARUDŽBE -->
                    <TabItem Header="{DynamicResource KlijentDetalji_Tab_Narudzbe}">
                        <DataGrid x:Name="dgNarudzbe"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"

                                  RowHeaderWidth="0"
                                  FontSize="14"
                                  Style="{DynamicResource DataGridBase}"
                                  ColumnHeaderStyle="{DynamicResource DataGridHeader}"
                                  RowStyle="{DynamicResource DataGridRow}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource KlijentDetalji_Narudzbe_ColBroj}"
                                                    Binding="{Binding BrojNarudzbe}"
                                                    Width="120"
                                                    ElementStyle="{DynamicResource CenterCell}"/>
                                <DataGridTextColumn Header="{DynamicResource KlijentDetalji_Narudzbe_ColDatum}"
                                                    Binding="{Binding Datum}"
                                                    Width="180"
                                                    ElementStyle="{DynamicResource CenterCell}"/>
                                <DataGridTextColumn Header="{DynamicResource KlijentDetalji_Narudzbe_ColStatus}"
                                                    Binding="{Binding Status}"
                                                    Width="*"
                                                    ElementStyle="{DynamicResource CenterCell}"/>
                                <DataGridTextColumn Header="{DynamicResource KlijentDetalji_Narudzbe_ColUkupno}"
                                                    Binding="{Binding UkupnaCijena, StringFormat=0.00}"
                                                    Width="130"
                                                    ElementStyle="{DynamicResource CenterCell}"/>

                                <!-- Akcije -->
                                <DataGridTemplateColumn Header="{DynamicResource KlijentDetalji_Narudzbe_ColAkcije}" Width="250" IsReadOnly="True" CanUserResize="False" CanUserReorder="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Width="45" Height="32" Margin="3"
        Click="BtnIzdajRacun_Click"
        Tag="{Binding BrojNarudzbe}"
        Style="{DynamicResource AppPrimaryButtonStyle}"
        ToolTip="{DynamicResource KlijentDetalji_Narudzbe_BtnIzdajRacun}"
        IsEnabled="{Binding MozeIzdatiRacun}">
                                                    <md:PackIcon Kind="FileDocumentMultiple" Foreground="White"/>
                                                </Button>


                                                <Button Width="45" Height="32" Margin="3"
                                                        Click="BtnPromijeniStatus_Click"
                                                        Tag="{Binding BrojNarudzbe}"
                                                        Style="{DynamicResource AppPrimaryButtonStyle}"
                                                        ToolTip="{DynamicResource KlijentDetalji_Narudzbe_BtnPromijeniStatus}">
                                                    <md:PackIcon Kind="Pencil" Foreground="White"/>
                                                </Button>
                                                <Button Width="45" Height="32" Margin="3"
                                                        Click="BtnOtvoriNarudzbu_Click"
                                                        Tag="{Binding BrojNarudzbe}"
                                                        Style="{DynamicResource AppPrimaryButtonStyle}"
                                                        ToolTip="{DynamicResource KlijentDetalji_Narudzbe_BtnOtvoriNarudzbu}">
                                                    <md:PackIcon Kind="ClipboardList" Foreground="White"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- RAČUNI -->
                    <TabItem Header="{DynamicResource KlijentDetalji_Tab_Racuni}">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="dgRacuni"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeaderWidth="0"
                                      CanUserAddRows="False"

                                      FontSize="14"
                                      Style="{DynamicResource DataGridBase}"
                                      ColumnHeaderStyle="{DynamicResource DataGridHeader}"
                                      RowStyle="{DynamicResource DataGridRow}"
                                      Grid.Row="0">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource KlijentDetalji_Racuni_ColBroj}"
                                                        Binding="{Binding BrojRacuna}"
                                                        Width="150"
                                                        ElementStyle="{DynamicResource CenterCell}"/>
                                    <DataGridTextColumn Header="{DynamicResource KlijentDetalji_Racuni_ColDatum}"
                                                        Binding="{Binding DatumIzdavanja}"
                                                        Width="180"
                                                        ElementStyle="{DynamicResource CenterCell}"/>
                                    <DataGridTextColumn Header="{DynamicResource KlijentDetalji_Racuni_ColIznos}"
                    Binding="{Binding UkupanIznos, StringFormat=0.00}"
                    Width="150"
                    ElementStyle="{DynamicResource CenterCell}"/>

                                        <DataGridTextColumn Header="{DynamicResource KlijentDetalji_Racuni_ColNacinPlacanja}"
                                                        Binding="{Binding NacinPlacanja}"
                                                        Width="120"
                                                        ElementStyle="{DynamicResource CenterCell}"/>

                                    <DataGridTemplateColumn Header="{DynamicResource KlijentDetalji_Racuni_ColAkcije}" Width="100" IsReadOnly="True" CanUserResize="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Width="45" Height="32"
                                                            Margin="4"
                                                            Cursor="Hand"
                                                            Click="BtnPregledajRacun_Click"
                                                            Tag="{Binding BrojRacuna}"
                                                            Style="{DynamicResource AppPrimaryButtonStyle}"
                                                            ToolTip="{DynamicResource KlijentDetalji_Racuni_BtnPregledajRacun}">
                                                        <md:PackIcon Kind="FileDocument" Foreground="White"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0 12 5 5">
                                <TextBlock Text="{DynamicResource KlijentDetalji_Racuni_TextUkupno}"
                                           FontSize="18"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtUkupno"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppHeaderBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- MJERE -->
                    <TabItem Header="{DynamicResource KlijentDetalji_Tab_Mjere}">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Content="{DynamicResource KlijentDetalji_Mjere_BtnDodajMjere}"
                                    Width="120" Height="32"
                                    Margin="0 0 0 10"
                                    Style="{DynamicResource AppPrimaryButtonStyle}"
                                    Click="BtnDodajMjere_Click"/>

                            <DataGrid x:Name="dgMjere"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeaderWidth="0"
                                      CanUserAddRows="False"

                                      FontSize="14"
                                      Style="{DynamicResource DataGridBase}"
                                      ColumnHeaderStyle="{DynamicResource DataGridHeader}"
                                      RowStyle="{DynamicResource DataGridRow}"
                                      Grid.Row="1">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource KlijentDetalji_Mjere_ColDatum}"
                                                        Binding="{Binding Datum}"
                                                        Width="150"
                                                        ElementStyle="{DynamicResource CenterCell}"/>

                                    <DataGridTemplateColumn Header="{DynamicResource KlijentDetalji_Mjere_ColAkcije}" Width="100" IsReadOnly="True" CanUserResize="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Width="45" Height="32"
                                                            Style="{DynamicResource AppPrimaryButtonStyle}"
                                                            Click="BtnDetaljiMjere_Click"
                                                            Tag="{Binding Datum}"
                                                            ToolTip="{DynamicResource KlijentDetalji_Mjere_BtnDetaljiMjere}">
                                                        <md:PackIcon Kind="ClipboardList" Foreground="White"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                </TabControl>

            </DockPanel>

        </Border>
        <md:Snackbar x:Name="SnackbarHost"
                         MessageQueue="{Binding SnackbarMessageQueue}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,20"
                         Width="340"/>

    </Grid>
</Window>
