<Window x:Class="Krojacnica.Views.NovaNarudzbaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/wpf/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource NNW_Title}"
        Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppGradientBrush}">

    <Grid Margin="20">
        <Border Style="{DynamicResource AppCardStyle}" Padding="20" Margin="0,-20,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- GORNJI PANEL -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Klijent -->
                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource NNW_Client}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbKlijent"
                                  DisplayMemberPath="ImePrezime"
                                  SelectedValuePath="osoba_id"
                                  Style="{DynamicResource AppComboBoxStyle}"
                                  SelectionChanged="cmbKlijent_SelectionChanged"/>
                    </StackPanel>

                    <!-- Mjere -->
                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="{DynamicResource NNW_Measurements}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbMjere"
                                  DisplayMemberPath="DatumMjerenja"
                                  SelectedValuePath="datum"
                                  Style="{DynamicResource AppComboBoxStyle}"/>
                        <Button Content="{DynamicResource NNW_Details}" Width="80" Margin="6,0,0,0"
                                Style="{DynamicResource AppPrimaryButtonStyle}"
                                Click="BtnPrikaziMjere_Click"/>
                    </StackPanel>

                    <!-- Datum -->
                    <StackPanel Grid.Column="2" Margin="5">
                        <TextBlock Text="{DynamicResource NNW_Date}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtDatum" IsReadOnly="True"
                                 Style="{DynamicResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Status -->
                    <StackPanel Grid.Column="3" Margin="5">
                        <TextBlock Text="{DynamicResource NNW_Status}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtStatus" IsReadOnly="True"
                                 Style="{DynamicResource AppTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- DODAVANJE STAVKI -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ponuda -->
                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource NNW_Offer}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbPonuda"
                                  DisplayMemberPath="Naziv"
                                  SelectedValuePath="Id"
                                   SelectionChanged="cmbPonuda_SelectionChanged"
                                  Style="{DynamicResource AppComboBoxStyle}"/>
                    </StackPanel>

                    <!-- Boja -->
                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="{DynamicResource NNW_Color}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbBoja"
                                  DisplayMemberPath="Naziv"
                                  SelectedValuePath="HexCode"
                                  
                                  Style="{DynamicResource AppComboBoxStyle}"/>
                    </StackPanel>

                    <!-- Količina -->
                    <StackPanel Grid.Column="2" Margin="5">
                        <TextBlock Text="{DynamicResource NNW_Quantity}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtKolicina" Width="90"
                                 Style="{DynamicResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Button Dodaj -->
                    <Button Grid.Column="3" Margin="10,28,0,0"
                            Content="{DynamicResource NNW_Add}" Width="120"
                            Style="{DynamicResource AppPrimaryButtonStyle}"
                            Click="BtnDodajStavku_Click"/>
                </Grid>

                <!-- TABELA -->
                <DataGrid Grid.Row="2" x:Name="dgStavke"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          Style="{DynamicResource DataGridBase}"
                          RowStyle="{DynamicResource DataGridRow}"
                          ColumnHeaderStyle="{DynamicResource DataGridHeader}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource NNW_Col_Name}" Binding="{Binding Naziv}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource NNW_Col_Type}" Binding="{Binding Tip}" Width="130"/>
                        <DataGridTextColumn Header="{DynamicResource NNW_Col_Quantity}" Binding="{Binding Kolicina}" Width="90"/>
                        <DataGridTextColumn Header="{DynamicResource NNW_Col_Consumption}" Binding="{Binding PotrosnjaMaterijala}" Width="140"/>
                        <DataGridTextColumn Header="{DynamicResource NNW_Col_Price}" Binding="{Binding Cijena}" Width="120"/>
                        <DataGridTextColumn Header="{DynamicResource NNW_Col_Total}" Binding="{Binding Ukupno}" Width="140"/>

                        <DataGridTemplateColumn Header="{DynamicResource NNW_Col_Action}" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{DynamicResource NNW_Action_Details}" Width="70"
                                                Style="{DynamicResource AppPrimaryButtonStyle}"
                                                Tag="{Binding}" Click="BtnEditStavka_Click"/>

                                        <Button Content="{DynamicResource NNW_Action_Remove}" Width="70"
                                                Style="{DynamicResource AppPrimaryButtonStyle}"
                                                Tag="{Binding}" Click="BtnUkloniStavku_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- DONJA LINIJA -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <TextBlock Text="{DynamicResource NNW_TotalLabel}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="txtUkupno" VerticalAlignment="Center" FontSize="16" Margin="0,0,20,0"/>
                    <Button Content="{DynamicResource NNW_SaveOrder}" Width="190" Height="40"
                            Style="{DynamicResource AppPrimaryButtonStyle}"
                            Click="BtnSacuvaj_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <md:Snackbar x:Name="SnackbarHost"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,20"
                         Width="450"/>
    </Grid>
</Window>
