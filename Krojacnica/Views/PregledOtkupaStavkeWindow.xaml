<Window x:Class="Krojacnica.Views.PregledOtkupaStavkeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Krojacnica.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource BuybackItemsWindow_Title}"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <local:HexToColorConverter x:Key="HexToColorConverter"/>
    </Window.Resources>

    <Grid Background="{DynamicResource AppGradientBrush}">

        <!-- CARD -->
        <Border Style="{DynamicResource AppCardStyle}" Margin="15,15,15,45" Padding="25"
                Name="CardBorder">
            <StackPanel>

                <!-- NASLOV -->
                <TextBlock Text="{DynamicResource BuybackItemsWindow_Header}"
                           FontSize="26"
                           Name="txtNaslov"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- DATAGRID -->
                <DataGrid x:Name="dgStavke"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                         
                          Style="{DynamicResource DataGridBase}"
                          HeadersVisibility="Column"
                          SelectionMode="Single">

                    <DataGrid.ColumnHeaderStyle>
                        <StaticResource ResourceKey="DataGridHeader"/>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <StaticResource ResourceKey="DataGridRow"/>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Buyback_Material}"
                                            Binding="{Binding Materijal}"
                                            Width="*"
                                            ElementStyle="{DynamicResource CenterCell}"/>

                        <DataGridTextColumn Header="{DynamicResource Buyback_Quality}"
                                            Binding="{Binding Kvalitet}"
                                            Width="120"
                                            ElementStyle="{DynamicResource CenterCell}"/>

                        <DataGridTextColumn Header="{DynamicResource Buyback_Price}"
                                            Binding="{Binding Cijena}"
                                            Width="120"
                                            ElementStyle="{DynamicResource CenterCell}"/>

                        <DataGridTextColumn Header="{DynamicResource Buyback_Quantity}"
                                            Binding="{Binding Kolicina}"
                                            Width="120"
                                            ElementStyle="{DynamicResource CenterCell}"/>

                        <DataGridTextColumn Header="{DynamicResource Buyback_Total}"
                                            Binding="{Binding Ukupno}"
                                            Width="120"
                                            ElementStyle="{DynamicResource CenterCell}"/>

                        <DataGridTemplateColumn Header="{DynamicResource Buyback_Color}" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="22" Height="22" CornerRadius="4"
                                            BorderBrush="#DDD" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding BojaHexCode, Converter={StaticResource HexToColorConverter}}"/>
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Zatvori dugme -->
                <Button Content="{DynamicResource Buyback_Close}"
                        Width="120"
                        Height="40"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0"
                        Style="{DynamicResource AppPrimaryButtonStyle}"
                        Click="BtnZatvori_Click"/>

            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="400"/>
    </Grid>
</Window>
