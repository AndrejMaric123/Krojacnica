<Window x:Class="Krojacnica.Views.MjestaManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource MjestaManagerWindow_Title}"
        Height="630" Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Background="{DynamicResource AppGradientBrush}">
        <!-- Card -->
        <Border x:Name="CardBorder"
                Style="{DynamicResource AppCardStyle}"
                Margin="15"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch">

            <StackPanel>
                <!-- Naslov -->
                <TextBlock Text="{DynamicResource MjestaManagerWindow_Header}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Search + Add -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="txtSearch"
                             Width="300" Height="40"
                             Style="{DynamicResource AppTextBoxStyle}"
                             materialDesign:HintAssist.Hint="{DynamicResource MjestaManagerWindow_HintSearch}"
                             TextChanged="txtSearch_TextChanged"
                             Margin="0,0,10,0"/>
                    <Button Content="{DynamicResource MjestaManagerWindow_ButtonAdd}"
                            Width="160" Height="40"
                            Style="{DynamicResource AppPrimaryButtonStyle}"
                            Click="AddMjesto_Click"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="dgMjesta"
                          Style="{DynamicResource DataGridBase}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MinHeight="300"
                          AlternationCount="2"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Hidden">

                    <DataGrid.ColumnHeaderStyle>
                        <StaticResource ResourceKey="DataGridHeader"/>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <StaticResource ResourceKey="DataGridRow"/>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource MjestaManagerWindow_ColumnPosta}"
                                            Binding="{Binding Posta}"
                                            Width="*"
                                            ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource MjestaManagerWindow_ColumnNaziv}"
                                            Binding="{Binding Naziv}"
                                            Width="*"
                                            ElementStyle="{DynamicResource CenterCell}"/>

                        <!-- Akcije -->
                        <DataGridTemplateColumn Header="{DynamicResource MjestaManagerWindow_ColumnAkcije}" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <Button Width="45" Height="30"
                                                Margin="4"
                                                Background="#2196F3"
                                                Click="Edit_Click"
                                                Style="{DynamicResource AppPrimaryButtonStyle}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="12"/>
                                                </Style>
                                            </Button.Resources>
                                            <md:PackIcon Kind="Pencil" Foreground="White"/>
                                        </Button>

                                        <Button Width="45" Height="30"
                                                Margin="4"
                                                Background="#E53935"
                                                Click="Delete_Click"
                                                Style="{DynamicResource AppPrimaryButtonStyle}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="12"/>
                                                </Style>
                                            </Button.Resources>
                                            <md:PackIcon Kind="TrashCan" Foreground="White"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty text -->
                <TextBlock x:Name="txtEmpty"
                           Text="{DynamicResource MjestaManagerWindow_EmptyText}"
                           Foreground="Gray"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0"/>

                <!-- Zatvori dugme -->
                <Button Content="{DynamicResource MjestaManagerWindow_ButtonClose}"
                        Width="110" Height="40"
                        HorizontalAlignment="Right"
                        Style="{DynamicResource AppPrimaryButtonStyle}"
                        Click="Close_Click"
                        Margin="0,15,0,0"/>
            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="450"/>
    </Grid>
</Window>
