<Window x:Class="Krojacnica.Views.EmployeesManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource Employees_Title}"
        Height="720" Width="1000"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <materialDesign:DialogHost x:Name="DialogHostRoot">
    <Grid Background="{DynamicResource AppGradientBrush}">

        <!-- CARD -->
        <Border x:Name="CardBorder"
        Style="{DynamicResource AppCardStyle}"
        Width="900"
        Height="600"
        VerticalAlignment="Top"
        HorizontalAlignment="Center" Margin="0,32,0,0">

            <!-- Koristimo Grid umjesto StackPanel -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Naslov + Search + Add -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Zatvori dugme -->
                </Grid.RowDefinitions>

                <!-- NASLOV -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Employees_Title}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppHeaderBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

                    <!-- Search + Add -->
                    <StackPanel Orientation="Horizontal">
                        <!-- Search -->
                        <DockPanel Width="350" Height="42" Margin="0,0,15,0">
                            <md:PackIcon Kind="Magnify"
                                 Width="22" Height="22"
                                 VerticalAlignment="Center"
                                 Margin="8,0"
                                 Foreground="{DynamicResource AppHeaderBrush}"/>
                            <TextBox Margin="5,0,0,0"
                             Name="txtSearch"
                             materialDesign:HintAssist.Hint="{DynamicResource Search_Placeholder}"
                             TextChanged="txtSearch_TextChanged"
                             BorderThickness="0"
                             FontSize="15"/>
                        </DockPanel>

                        <!-- Add Button -->
                        <Button Style="{DynamicResource AppPrimaryButtonStyle}"
                        Width="200" Height="42"
                        Click="AddEmployee_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <md:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,6,0" Foreground="White"/>
                                <TextBlock Text="{DynamicResource Btn_AddEmployee}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- DATAGRID -->
                <DataGrid x:Name="dgEmployees"
                  Grid.Row="1"
                  ItemsSource="{Binding Zaposleni}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Style="{DynamicResource DataGridBase}"
                  ColumnHeaderStyle="{DynamicResource DataGridHeader}"
                  RowStyle="{DynamicResource DataGridRow}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  Margin="0,0,0,0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Col_Ime}" Binding="{Binding Ime}" Width="*" ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource Col_Prezime}" Binding="{Binding Prezime}" Width="*" ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource Col_Username}" Binding="{Binding KorisnickoIme}" Width="*" ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource Col_DatumOd}" Binding="{Binding DatumZaposlenjaOd, StringFormat=d}" />
                        <DataGridTextColumn Header="{DynamicResource Col_DatumDo}" Binding="{Binding DatumZaposlenjaDo, StringFormat=d}" />

                        <!-- Akcije -->
                        <DataGridTemplateColumn Header="{DynamicResource Col_Akcije}" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <!-- Delete -->
                                        <Button Width="45" Height="32" Margin="4"
                                                Background="#E53935"
                                                Click="DeleteEmployee_Click"
                                                Style="{StaticResource MaterialDesignRaisedButton}">
                                            <md:PackIcon Kind="TrashCan" Foreground="White"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty text -->
                <TextBlock x:Name="txtEmpty"
                           Text="{DynamicResource Empty_Text}"
                           Foreground="Gray"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0"/>

                <Button Content="{DynamicResource Btn_Close}"
                Grid.Row="2"
                Width="110" Height="40"
                HorizontalAlignment="Right"
                Style="{DynamicResource AppPrimaryButtonStyle}"
                Click="Close_Click"
                Margin="0,15,0,15"/>
            </Grid>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,25"
                                 MessageQueue="{Binding SnackbarQueue}"
                                 Width="450"/>
    </Grid>
    </materialDesign:DialogHost>
</Window>
