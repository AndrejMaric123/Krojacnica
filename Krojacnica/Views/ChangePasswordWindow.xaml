<Window x:Class="Krojacnica.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource ChangePassword_Title}"
        Height="450" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Background="{DynamicResource AppGradientBrush}">

        <!-- Card panel -->
        <Border x:Name="CardBorder"
                Style="{DynamicResource AppCardStyle}"
                Width="380"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,23,0,0">
            <StackPanel HorizontalAlignment="Center" Width="300">

                <!-- Naslov -->
                <TextBlock Text="{DynamicResource ChangePassword_Title}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Korisničko ime -->
                <TextBox x:Name="TxtUsername"
                         Style="{DynamicResource AppTextBoxStyle}"
                         materialDesign:HintAssist.Hint="{DynamicResource ChangePassword_Username}"
                         Margin="0,5"/>

                <!-- Stara lozinka -->
                <PasswordBox x:Name="PwdOldPassword"
                             Style="{DynamicResource AppPasswordBoxStyle}"
                             materialDesign:HintAssist.Hint="{DynamicResource ChangePassword_OldPassword}"
                             Margin="0,5"/>

                <!-- Nova lozinka -->
                <PasswordBox x:Name="PwdNewPassword"
                             Style="{DynamicResource AppPasswordBoxStyle}"
                             materialDesign:HintAssist.Hint="{DynamicResource ChangePassword_NewPassword}"
                             Margin="0,5"/>

                <!-- Dugmad Sačuvaj / Otkaži -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="{DynamicResource ChangePassword_Save}"
                            Width="110" Margin="0,0,10,0"
                            Style="{DynamicResource AppPrimaryButtonStyle}"
                            Click="BtnSave_Click"/>
                    <Button Content="{DynamicResource ChangePassword_Cancel}"
                            Width="110"
                            Style="{DynamicResource AppPrimaryButtonStyle}"
                            Click="BtnCancel_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 MessageQueue="{Binding SnackbarMessageQueue}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="300"/>
    </Grid>
</Window>
