<Window x:Class="Krojacnica.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource LoginWindow_Title}"
        Height="520" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
  
        Background="#FFF9F9F9"
        Icon="/Resources/favicon.ico">

    <Window.Resources>
        <!-- Boje -->
        <SolidColorBrush x:Key="Rose" Color="#b84688"/>
        <SolidColorBrush x:Key="Mint" Color="#54c583"/>
        <LinearGradientBrush x:Key="LeftGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#b84688" Offset="0"/>
            <GradientStop Color="#54c583" Offset="1"/>
        </LinearGradientBrush>

        <!-- Stil dugmeta -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#00c46c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
           
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#41dd8c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Lijevi panel -->
        <Border Grid.Column="0" Background="{StaticResource LeftGradient}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                <Image Source="Images/SewItYourWayLogo.jpeg"
                       Width="140" Height="140" Stretch="UniformToFill" Margin="0,0,0,16">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,140,140" RadiusX="20" RadiusY="20"/>
                    </Image.Clip>
                </Image>
                <TextBlock Text="{DynamicResource LoginWindow_Header}"
                           FontSize="42" FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource LoginWindow_SubHeader}"
                           FontSize="18"
                           Foreground="#F0FFFFFF"
                           FontStyle="Italic"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Desni panel -->
        <Grid Grid.Column="1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <Border Background="White"
                        CornerRadius="14"
                        Padding="32"
                        >
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LoginWindow_Header}"
                                   Foreground="{StaticResource Rose}"
                                   FontWeight="Bold"
                                   FontSize="22"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource LoginWindow_SubHeader}"
                                   FontSize="13"
                                   Foreground="#666"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,16"/>

                        <!-- Username -->
                        <TextBox x:Name="TxtUsername"
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="{DynamicResource LoginWindow_HintUsername}"
                                 Height="60"
                                 FontSize="14"
                                 Margin="0,0,0,8"/>

                        <!-- Password -->
                        <PasswordBox x:Name="PwdPassword"
                                     Style="{DynamicResource MaterialDesignOutlinedPasswordBox}"
                                     materialDesign:HintAssist.Hint="{DynamicResource LoginWindow_HintPassword}"
                                     Height="60"
                                     FontSize="14"
                                     Margin="0,0,0,12"/>

                        <!-- Remember + Forgot -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkRemember" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource LoginWindow_RememberMe}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  Cursor="Hand"
                                  MouseDown="ForgotPassword_MouseDown"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,0,0">

                                <TextBlock x:Name="ForgotPasswordText"
                                           Text="{DynamicResource LoginWindow_ForgotPassword}"
                                           Foreground="{StaticResource Rose}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Left"/>

                                <Rectangle x:Name="Underline"
                                           Height="2"
                                           Fill="{StaticResource Rose}"
                                           HorizontalAlignment="Left"
                                           Width="0"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,0"/>

                                <!-- Animacije ostaju iste -->
                            </Grid>
                        </Grid>

                        <!-- Login dugme -->
                        <Button Content="{DynamicResource LoginWindow_ButtonLogin}"
                                Style="{StaticResource PrimaryButton}"
                                Height="44"
                                Click="LoginButton_Click"/>

                        <TextBlock Text="{DynamicResource LoginWindow_InfoText}"
                                   FontSize="11"
                                   Foreground="#888"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>