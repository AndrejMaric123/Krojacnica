<Window x:Class="Krojacnica.Views.PregledOtkupaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource BuybackOverview_Title}"
        Width="1000" Height="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Background="{DynamicResource AppGradientBrush}">

        <!-- CARD -->
        <Border Style="{DynamicResource AppCardStyle}" Margin="15,15,15,45"
                Name="CardBorder">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- NASLOV -->
                <TextBlock Text="{DynamicResource BuybackOverview_Header}"
                           FontSize="26"
                           Name="txtNaslov"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- DATAGRID -->
                <Grid Grid.Row="1">
                    <DataGrid x:Name="dgOtkupi"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternationCount="2"
                              Style="{DynamicResource DataGridBase}"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch">

                        <DataGrid.ColumnHeaderStyle>
                            <StaticResource ResourceKey="DataGridHeader"/>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <StaticResource ResourceKey="DataGridRow"/>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="{DynamicResource BuybackOverview_ConfirmationNumber}"
                                                Binding="{Binding broj_potvrde}"
                                                Width="*"
                                                ElementStyle="{DynamicResource CenterCell}"/>

                            <DataGridTextColumn Header="{DynamicResource BuybackOverview_Date}"
                                                Binding="{Binding datum}"
                                                Width="*"
                                                ElementStyle="{DynamicResource CenterCell}"/>

                            <DataGridTextColumn Header="{DynamicResource BuybackOverview_TotalKM}"
                                                Binding="{Binding Ukupno, StringFormat=N2}"
                                                Width="*"
                                                ElementStyle="{DynamicResource CenterCell}"/>

                            <!-- AKCIJE -->
                            <DataGridTemplateColumn Header="{DynamicResource BuybackOverview_Actions}" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >

                                            <!-- STAVKE -->
                                            <Button Style="{DynamicResource AppPrimaryButtonStyle}"
                                                    Tag="{Binding broj_potvrde}"
                                                    ToolTip="{DynamicResource BuybackOverview_Action_Items}"
                                                    Click="PrikaziStavke_Click"
                                                    Width="80" Height="35">
                                                <md:PackIcon Kind="ListBox" Width="22" Height="22" Foreground="White"/>
                                            </Button>

                                            <!-- ISPLATE -->
                                            <Button Style="{DynamicResource AppPrimaryButtonStyle}"
                                                    Tag="{Binding broj_potvrde}"
                                                    ToolTip="{DynamicResource BuybackOverview_Action_Payments}"
                                                    Click="OpenIsplate_Click"
                                                    Width="80" Height="35">
                                                <md:PackIcon Kind="Cash" Width="22" Height="22" Foreground="White"/>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty text -->
                    <TextBlock x:Name="txtEmpty"
                               Text="{DynamicResource BuybackOverview_EmptyText}"
                               Foreground="Gray"
                               FontStyle="Italic"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>

                <!-- SUMARNI PANEL -->
                <Border Grid.Row="1"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="0 0 10 10"
                        Padding="15"
                        Background="#fafafa"
                        CornerRadius="12"
                        BorderBrush="#dcdcdc"
                        BorderThickness="1"
                        Width="260">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0 3">
                            <TextBlock Text="{DynamicResource BuybackOverview_Summary_TotalBought}" FontWeight="Bold"/>
                            <TextBlock x:Name="txtUkupnoOtkup" Margin="5 0 0 0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0 3">
                            <TextBlock Text="{DynamicResource BuybackOverview_Summary_TotalPaid}" FontWeight="Bold"/>
                            <TextBlock x:Name="txtUkupnoIsplate" Margin="5 0 0 0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0 3">
                            <TextBlock Text="{DynamicResource BuybackOverview_Summary_Debt}" FontWeight="Bold" Foreground="#b80000"/>
                            <TextBlock x:Name="txtDug" Margin="5 0 0 0" Foreground="#b80000"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="450"/>
    </Grid>
</Window>
