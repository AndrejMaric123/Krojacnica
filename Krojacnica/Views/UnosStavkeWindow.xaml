<Window x:Class="Krojacnica.Views.UnosStavkeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{StaticResource  UnosStavke_Title}"
        Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Background="{StaticResource  AppGradientBrush}">
        <!-- Card panel -->
        <Border Style="{StaticResource  AppCardStyle}" 
                Name="CardBorder"
                Width="380" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,21,0,0">
            <StackPanel HorizontalAlignment="Center" Width="300">
                <!-- Naslov -->
                <TextBlock Text="{StaticResource  UnosStavke_Header}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource  AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Količina -->
                <TextBox x:Name="txtKolicina"
                         Style="{StaticResource  AppTextBoxStyle}"
                         materialDesign:HintAssist.Hint="{StaticResource  UnosStavke_Kolicina}"
                         Margin="0,5"/>

                <!-- Boja -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ComboBox x:Name="cbBoje" Width="240"
                              DisplayMemberPath="Naziv"
                              SelectedValuePath="HexCode"
                              Style="{StaticResource  AppComboBoxStyle}"/>
                    <Border x:Name="selectedColorPreview"
                            Width="50" Height="50" BorderBrush="Black" BorderThickness="1" CornerRadius="3"
                            Background="White" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Dugmad Dodaj / Otkaži -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="{StaticResource  UnosStavke_Add}" Width="110" Margin="0,0,10,0"
                            Style="{StaticResource  AppPrimaryButtonStyle}"
                            Click="BtnDodaj_Click"/>
                    <Button Content="{StaticResource  UnosStavke_Cancel}" Width="120"
                            Style="{StaticResource  AppPrimaryButtonStyle}"
                            Click="BtnOtkazi_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="300"/>
    </Grid>
</Window>
