<Window x:Class="Krojacnica.Views.EditArtikalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:local="clr-namespace:Krojacnica.Converters"
        Title="{DynamicResource EditArtikal_Title}"
        Height="700" Width="450"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <local:HexToColorConverter x:Key="HexToColorConverter"/>
        <local:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>

        <!-- Fade + slide animacija -->
        <Storyboard x:Key="WindowEnterAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                             From="25" To="0" Duration="0:0:0.35"
                             DecelerationRatio="0.8"/>
        </Storyboard>
    </Window.Resources>

    <Grid Background="{DynamicResource AppGradientBrush}">

        <!-- CARD -->
        <Border x:Name="CardBorder"
                Style="{DynamicResource AppCardStyle}"
                Width="400"
                Height="620"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel HorizontalAlignment="Center">

                <!-- NASLOV -->
                <TextBlock Text="{DynamicResource EditArtikal_Title}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- POLJA ZA ARTIKAL -->
                <StackPanel Orientation="Vertical" Width="300">
                    <TextBox x:Name="txtNazivArtikla"
                             Style="{DynamicResource AppTextBoxStyle}"
                             materialDesign:HintAssist.Hint="{DynamicResource EditArtikal_LabelNaziv}"
                             Margin="0,0,0,10"/>

                    <ComboBox x:Name="cmbMaterijal"
                              Style="{DynamicResource AppComboBoxStyle}"
                              SelectedValuePath="id"
                              Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} ({1})">
                                            <Binding Path="naziv"/>
                                            <Binding Path="kvalitet"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox x:Name="cmbBoje"
                              Style="{DynamicResource AppComboBoxStyle}"
                              DisplayMemberPath="naziv"
                              Margin="0,0,0,10"/>

                    <TextBox x:Name="txtCijenaArtikla"
                             Style="{DynamicResource AppTextBoxStyle}"
                             materialDesign:HintAssist.Hint="{DynamicResource EditArtikal_LabelCijena}"
                             Margin="0,0,0,10"/>

                    <!-- Odabir slike + preview -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10" VerticalAlignment="Center">
                        <Button Content="{DynamicResource EditArtikal_ButtonOdaberiSliku}"
                                Width="150"
                                Height="50"
                                Name="btnOdaberiSliku"
                                Style="{DynamicResource AppPrimaryButtonStyle}"
                                Click="BtnOdaberiSliku_Click"/>
                        <Image x:Name="imgPreview"
                               Width="150"
                               Height="150"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- DUGMAD SPREMI / OTKAŽI -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="{DynamicResource EditArtikal_ButtonSpremi}"
                            Width="110"
                            Height="40"
                            Name="btnSpremi"
                            Style="{DynamicResource AppPrimaryButtonStyle}"
                            Click="BtnSpremi_Click"
                            Margin="0,0,10,0"/>
                    <Button Content="{DynamicResource EditArtikal_ButtonOtkazi}"
                            Width="110"
                            Height="40"
                            Background="#b84688"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            Click="BtnOtkaži_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="300"/>
    </Grid>
</Window>
