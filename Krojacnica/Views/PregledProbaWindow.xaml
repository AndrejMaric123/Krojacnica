<Window x:Class="Krojacnica.Views.PregledProbaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource ProbaOverview_Title}"
        Height="530" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Background="{DynamicResource AppGradientBrush}">
        <!-- Card panel -->
        <Border Style="{DynamicResource AppCardStyle}" Margin="15,8,15,45"
                Name="CardBorder">
            <StackPanel>

                <!-- Naslov -->
                <TextBlock Text="{DynamicResource ProbaOverview_Header}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- DataGrid -->
                <DataGrid x:Name="dgProba"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          MinHeight="260"
                          AlternationCount="2"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          Style="{DynamicResource DataGridBase}"
                          HorizontalScrollBarVisibility="Hidden"
                          SelectionMode="Single">

                    <DataGrid.ColumnHeaderStyle>
                        <StaticResource ResourceKey="DataGridHeader"/>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <StaticResource ResourceKey="DataGridRow"/>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource ProbaOverview_Date}"
                                            Binding="{Binding datum_probe}"
                                            Width="150"
                                            ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource ProbaOverview_Comment}"
                                            Binding="{Binding komentar}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tekst ako nema stavki -->
                <TextBlock x:Name="txtEmpty"
                           Text="{DynamicResource ProbaOverview_EmptyText}"
                           Foreground="Gray"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0"/>

                <!-- Zatvori dugme -->
                <Button Content="{DynamicResource ProbaOverview_CloseButton}"
                        Width="110"
                        Height="36"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Style="{DynamicResource AppPrimaryButtonStyle}"
                        Click="BtnZatvori_Click"/>
            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="350"/>
    </Grid>
</Window>
