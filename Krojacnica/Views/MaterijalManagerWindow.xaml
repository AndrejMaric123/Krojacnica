<Window x:Class="Krojacnica.Views.MaterijalManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource MaterijalManagerWindow_Title}"
        Height="660" Width="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Background="{DynamicResource AppGradientBrush}">
        <!-- Card panel -->
        <Border x:Name="CardBorder"
                Style="{DynamicResource AppCardStyle}"
                Margin="30,25,30,0"
                VerticalAlignment="Top">

            <StackPanel>
                <!-- Naslov -->
                <TextBlock Text="{DynamicResource MaterijalManagerWindow_Header}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Search + Add dugme -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <md:PackIcon Kind="Magnify"
             Width="22" Height="22"
             VerticalAlignment="Center"
             Margin="8,0"
             Foreground="{DynamicResource AppHeaderBrush}"/>
                    <TextBox x:Name="txtSearch"
                             Width="300" Height="53"
                             Style="{DynamicResource AppTextBoxStyle}"
                             materialDesign:HintAssist.Hint="{DynamicResource MaterijalManagerWindow_HintSearch}"
                             TextChanged="txtSearch_TextChanged"
                             BorderThickness="0"
                             Margin="0,0,10,0"/>
                    <Button Width="160" Height="53"
                            Style="{DynamicResource AppPrimaryButtonStyle}"
                            Click="Add_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,6,0" Foreground="White"/>
                            <TextBlock Text="{DynamicResource MaterijalManagerWindow_ButtonAdd}"/>
                        </StackPanel>
                        
                    </Button>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="dgMaterijali"
                          Style="{DynamicResource DataGridBase}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MinHeight="300"
                          HeadersVisibility="Column"
                          AlternationCount="2"
                          HorizontalScrollBarVisibility="Hidden">

                    <DataGrid.ColumnHeaderStyle>
                        <StaticResource ResourceKey="DataGridHeader"/>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <StaticResource ResourceKey="DataGridRow"/>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource MaterijalManagerWindow_ColumnNaziv}"
                                            Binding="{Binding Naziv}"
                                            Width="*"
                                            ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource MaterijalManagerWindow_ColumnKvalitet}"
                                            Binding="{Binding Kvalitet}"
                                            Width="*"
                                            ElementStyle="{DynamicResource CenterCell}"/>

                        <!-- Akcije -->
                        <DataGridTemplateColumn Header="{DynamicResource MaterijalManagerWindow_ColumnAkcije}" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <Button Width="45" Height="30"
                                                Margin="4"
                                                
                                                Click="Edit_Click"
                                                Style="{DynamicResource AppPrimaryButtonStyle}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="12"/>
                                                </Style>
                                            </Button.Resources>
                                            <md:PackIcon Kind="Pencil" Foreground="White"/>
                                        </Button>

                                        <Button Width="45" Height="30"
                                                Margin="4"
                                                Background="#E53935"
                                                Click="Delete_Click"
                                                Style="{DynamicResource AppPrimaryButtonStyle}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="12"/>
                                                </Style>
                                            </Button.Resources>
                                            <md:PackIcon Kind="TrashCan" Foreground="White"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty text -->
                <TextBlock x:Name="txtEmpty"
                           Text="{DynamicResource MaterijalManagerWindow_EmptyText}"
                           Foreground="Gray"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0"/>

                <!-- Zatvori dugme -->
                <Button Width="110" Height="40"
                        HorizontalAlignment="Right"
                        Style="{DynamicResource AppPrimaryButtonStyle}"
                        Click="Close_Click"
                        Margin="0,15,0,0">
                    <TextBlock Text="{DynamicResource MaterijalManagerWindow_ButtonClose}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="450"/>
    </Grid>
</Window>
