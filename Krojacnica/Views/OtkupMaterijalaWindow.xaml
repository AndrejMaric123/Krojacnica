<Window x:Class="Krojacnica.Views.OtkupMaterijalaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:local="clr-namespace:Krojacnica.Converters"
        Title="{DynamicResource Otkup_Title}"
        Height="680" Width="1100"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">

    <Window.Resources>
        <local:HexToColorConverter x:Key="HexToColorConverter"/>
    </Window.Resources>

    <Grid Background="{DynamicResource AppGradientBrush}">

        <Border Style="{DynamicResource AppCardStyle}"
                Width="992" Height="600"
                VerticalAlignment="Top"
                HorizontalAlignment="Center" Margin="0,12,0,0">

            <StackPanel>

                <!-- Naslov -->
                <TextBlock Text="{DynamicResource Otkup_Header}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- Dobavljač -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Otkup_Dobavljac}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <ComboBox x:Name="cbDobavljaci"
                              Width="300"
                              DisplayMemberPath="NazivIliIme"
                              Style="{DynamicResource AppComboBoxStyle}"
                              SelectionChanged="cbDobavljaci_SelectionChanged"/>
                </StackPanel>

                <!-- Glavni grid -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Materijali -->
                    <DataGrid x:Name="dgMaterijali"
                              Style="{DynamicResource DataGridBase}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="{DynamicResource DataGridBase.AlternatingRowBackground}"
                              HeadersVisibility="Column"
                              Margin="0,0,5,0"
                              Height="200">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Otkup_Materijal}"
                                                Binding="{Binding MaterijalNaziv}" Width="*"
                                                ElementStyle="{DynamicResource CenterCell}"/>
                            <DataGridTextColumn Header="{DynamicResource Otkup_Cijena}"
                                                Binding="{Binding Cijena}" Width="*"
                                                ElementStyle="{DynamicResource CenterCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Dugmad -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                        <Button Width="100" Height="35" Margin="5"
                                Style="{DynamicResource AppPrimaryButtonStyle}"
                                Click="AddToOtkup_Click">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowRightBold"
                                             Width="20" Height="20" Margin="0,0,6,0" Foreground="White"/>
                                <TextBlock Text="{DynamicResource Otkup_Add}"/>
                            </StackPanel>
                        </Button>

                        <Button Width="100" Height="35" Margin="5"
                                Style="{DynamicResource AppPrimaryButtonStyle}"
                                Click="RemoveFromOtkup_Click">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowLeftBold"
                                             Width="20" Height="20" Margin="0,0,6,0" Foreground="White"/>
                                <TextBlock Text="{DynamicResource Otkup_Remove}"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Stavke otkupa -->
                    <DataGrid x:Name="dgOtkup"
                              Grid.Column="2"
                              Style="{DynamicResource DataGridBase}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              AlternatingRowBackground="{DynamicResource DataGridBase.AlternatingRowBackground}"
                              HeadersVisibility="Column"
                              Height="200"
                              Margin="5,5,-19,5">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="{DynamicResource Otkup_Materijal}"
                                                Binding="{Binding MaterijalNaziv}" Width="*"
                                                ElementStyle="{DynamicResource CenterCell}"/>

                            <DataGridTextColumn Header="{DynamicResource Otkup_Cijena}"
                                                Binding="{Binding Cijena}" Width="*"
                                                ElementStyle="{DynamicResource CenterCell}"/>

                            <DataGridTextColumn Header="{DynamicResource Otkup_Kolicina}"
                                                Binding="{Binding Kolicina}" Width="*"
                                                ElementStyle="{DynamicResource CenterCell}"/>

                            <DataGridTextColumn Header="{DynamicResource Otkup_Ukupno}"
                                                Binding="{Binding Ukupno}" Width="*"
                                                ElementStyle="{DynamicResource CenterCell}"/>

                            <DataGridTemplateColumn Header="{DynamicResource Otkup_Boja}" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="20" Height="20"
                                                CornerRadius="3" BorderBrush="Black" BorderThickness="1">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding BojaHexCode, Converter={StaticResource HexToColorConverter}}"/>
                                            </Border.Background>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>

                <!-- Ukupno + Sačuvaj -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <TextBlock Text="{DynamicResource Otkup_Ukupno}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="txtUkupno"
                               Text="0.00"
                               FontWeight="Bold"
                               Margin="5,0,20,0"
                               VerticalAlignment="Center"/>

                    <Button Width="150" Height="40"
                            Style="{DynamicResource AppPrimaryButtonStyle}"
                            Click="SaveOtkup_Click">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,6,0" Foreground="White"/>
                            <TextBlock Text="{DynamicResource Otkup_Save}"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </StackPanel>
        </Border>
        <md:Snackbar x:Name="SnackbarHost"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,20"
                 Width="450"/>
    </Grid>
</Window>
