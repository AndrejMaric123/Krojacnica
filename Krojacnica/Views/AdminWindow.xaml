<Window x:Class="Krojacnica.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource Admin_Title}" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource AppGradientBrush}">

    <DockPanel>
        <!-- Sidebar -->
        <StackPanel DockPanel.Dock="Left" Width="220" Background="{DynamicResource AppSidebarBrush}">
            <TextBlock Text="{DynamicResource Admin_Title}"
                       Foreground="{DynamicResource AppSidebarTextBrush}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="10"
                       TextAlignment="Center"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Sidebar buttons -->
                    <Button Click="ViewEmployees_Click" Style="{DynamicResource AppSidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AccountGroup" Width="24" Height="24"/>
                            <TextBlock Text="{DynamicResource Sidebar_Employees}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ViewClients_Click" Style="{DynamicResource AppSidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AccountMultiple" Width="24" Height="24"/>
                            <TextBlock Text="{DynamicResource Sidebar_Clients}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ManagePonude_Click" Style="{DynamicResource AppSidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ClipboardText" Width="24" Height="24"/>
                            <TextBlock Text="{DynamicResource Sidebar_Ponude}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ManageMaterijali_Click" Style="{DynamicResource AppSidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="CubeOutline" Width="24" Height="24"/>
                            <TextBlock Text="{DynamicResource Sidebar_Materijali}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ManageDobavljaci_Click" Style="{DynamicResource AppSidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Truck" Width="24" Height="24"/>
                            <TextBlock Text="{DynamicResource Sidebar_Dobavljaci}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ManageColors_Click" Style="{DynamicResource AppSidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Palette" Width="24" Height="24"/>
                            <TextBlock Text="{DynamicResource Sidebar_Colors}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ManageZalihe_Click" Style="{DynamicResource AppSidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Archive" Width="24" Height="24"/>
                            <TextBlock Text="{DynamicResource Sidebar_Zalihe}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ManageOtkupi_Click" Style="{DynamicResource AppSidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="CashMultiple" Width="24" Height="24"/>
                            <TextBlock Text="{DynamicResource Sidebar_Otkupi}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ManageDodajNarudbzu_Click" Style="{DynamicResource AppSidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="CartPlus" Width="24" Height="24"/>
                            <TextBlock Text="{DynamicResource Sidebar_AddOrder}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Logout -->
                    <Button Click="Logout_Click" 
                            Background="{DynamicResource AppPrimaryButtonStyleBackground}" 
                            Foreground="{DynamicResource AppPrimaryButtonStyleForeground}"
                            Margin="5" Padding="10" FontWeight="SemiBold" Height="42">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="LogoutVariant" Width="24" Height="24"/>
                            <TextBlock Text="{DynamicResource Sidebar_Logout}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Tema dugmad -->
                    <StackPanel Margin="5,20,5,0">
                        <TextBlock Text="{DynamicResource Sidebar_Theme}" 
                                   Foreground="{DynamicResource AppSidebarTextBrush}" 
                                   FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Button Content="{DynamicResource Sidebar_LightTheme}" Click="BtnLightTheme_Click" 
                                Background="{DynamicResource AppSidebarBrush}" 
                                Foreground="{DynamicResource AppSidebarTextBrush}" Margin="0,2"/>
                        <Button Content="{DynamicResource Sidebar_DarkTheme}" Click="BtnDarkTheme_Click" 
                                Background="{DynamicResource AppSidebarBrush}" 
                                Foreground="{DynamicResource AppSidebarTextBrush}" Margin="0,2"/>
                        <Button Content="{DynamicResource Sidebar_GrayTheme}" Click="BtnGrayTheme_Click" 
                                Background="{DynamicResource AppSidebarBrush}" 
                                Foreground="{DynamicResource AppSidebarTextBrush}" Margin="0,2"/>
                    </StackPanel>

                    <!-- Jezik -->
                    <TextBlock Text="{DynamicResource Sidebar_Language}" 
                               Foreground="{DynamicResource AppSidebarTextBrush}" 
                               FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <Button Content="{DynamicResource Sidebar_BS}" Click="BtnLangBS_Click"
                            Background="{DynamicResource AppSidebarBrush}" 
                            Foreground="{DynamicResource AppSidebarTextBrush}" Margin="0,2"/>
                    <Button Content="{DynamicResource Sidebar_EN}" Click="BtnLangEN_Click"
                            Background="{DynamicResource AppSidebarBrush}" 
                            Foreground="{DynamicResource AppSidebarTextBrush}" Margin="0,2"/>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <!-- Glavni sadržaj -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border Style="{DynamicResource AppCardStyle}" Padding="20" Margin="20" Height="683">
                <WrapPanel x:Name="MainCardsWrapPanel" ItemWidth="300" ItemHeight="Auto" Orientation="Horizontal" />
            </Border>
        </ScrollViewer>
        
    </DockPanel>
   
</Window>
