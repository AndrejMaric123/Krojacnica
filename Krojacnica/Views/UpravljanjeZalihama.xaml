<Window x:Class="Krojacnica.Views.UpravljanjeZalihama"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource UpravljanjeZalihama_Title}"
        Height="680" Width="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Background="{DynamicResource AppGradientBrush}">

        <!-- Card panel -->
        <Border Style="{DynamicResource AppCardStyle}" Margin="15,14,15,0" VerticalAlignment="Top"
                Name="CardBorder" Height="597">
            <StackPanel>
                <TextBlock Text="{DynamicResource UpravljanjeZalihama_Header}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- 🔍 Filter / Search -->
                <TextBox x:Name="txtSearch"
                         Style="{DynamicResource AppTextBoxStyle}"
                         materialDesign:HintAssist.Hint="{DynamicResource UpravljanjeZalihama_SearchHint}"
                         HorizontalAlignment="Left"
                         Width="250"
                         Margin="0,0,0,15"
                         TextChanged="txtSearch_TextChanged"/>

                <!-- 📋 Tabela materijala -->
                <DataGrid x:Name="dgMaterijali"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MinHeight="350"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Style="{DynamicResource DataGridBase}"
                          ColumnHeaderStyle="{DynamicResource DataGridHeader}"
                          RowStyle="{DynamicResource DataGridRow}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource UpravljanjeZalihama_Column_Naziv}" Binding="{Binding Naziv}" Width="*" ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource UpravljanjeZalihama_Column_Kvalitet}" Binding="{Binding Kvalitet}" Width="*" ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTemplateColumn Header="{DynamicResource UpravljanjeZalihama_Column_Boja}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BojaHex}" CornerRadius="4" Height="25" Width="60" Margin="4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource UpravljanjeZalihama_Column_DostupnaKolicina}" Binding="{Binding DostupnaKolicina}" Width="*" ElementStyle="{DynamicResource CenterCell}"/>

                        <!-- 🧰 Akcije -->
                        <DataGridTemplateColumn Header="{DynamicResource UpravljanjeZalihama_Column_Akcije}" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Width="50" Height="45" Margin="4"
                                                Style="{DynamicResource AppPrimaryButtonStyle}"
                                                BorderThickness="0"
                                                ToolTip="{DynamicResource UpravljanjeZalihama_ManageDobavljaci_Tooltip}"
                                                Click="ManageDobavljaci_Click">
                                            <Viewbox>
                                                <md:PackIcon Kind="TruckDelivery" Foreground="White"/>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="txtEmpty"
                           Text="{DynamicResource UpravljanjeZalihama_EmptyText}"
                           Foreground="Gray"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Margin="0,10,0,0"/>

                <!-- Zatvori dugme -->
                <Button Content="{DynamicResource UpravljanjeZalihama_CloseButton}"
                        Width="100"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0"
                        Style="{DynamicResource AppPrimaryButtonStyle}"
                        Click="Close_Click"/>
            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="450"/>
    </Grid>
</Window>
