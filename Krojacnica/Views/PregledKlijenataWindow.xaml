<Window x:Class="Krojacnica.Views.PregledKlijenataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource PregledKlijenataWindow_Title}"
        Width="1050" Height="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <materialDesign:DialogHost x:Name="DialogHostRoot">
        <Grid Background="{DynamicResource AppGradientBrush}">

            <!-- CARD -->
            <Border Style="{DynamicResource AppCardStyle}"
                Width="920"
                Height="607"
                VerticalAlignment="Top"
                HorizontalAlignment="Center" Margin="0,7,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Naslov + Search + Add -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid -->
                        <RowDefinition Height="Auto"/>
                        <!-- Zatvori dugme -->
                    </Grid.RowDefinitions>

                    <!-- NASLOV + SEARCH + ADD -->
                    <StackPanel Grid.Row="0" Margin="15,15,15,10">
                        <TextBlock Text="{DynamicResource PregledKlijenataWindow_Header}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppHeaderBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                        <!-- Search + Add dugme -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <!-- Search -->
                            <DockPanel Width="350" Height="42" Margin="0,0,15,0">
                                <md:PackIcon Kind="Magnify"
                                         Width="22" Height="22"
                                         VerticalAlignment="Center"
                                         Margin="8,0"
                                         Foreground="{DynamicResource AppHeaderBrush}"/>
                                <TextBox Margin="5,0,0,0"
                                     Name="txtSearch"
                                     materialDesign:HintAssist.Hint="{DynamicResource Search_Placeholder}"
                                     TextChanged="txtSearch_TextChanged"
                                     BorderThickness="0"
                                     FontSize="15"/>
                            </DockPanel>

                            <!-- Add Button -->
                            <Button Style="{DynamicResource AppPrimaryButtonStyle}"
                                Width="200" Height="42"
                                Click="AddKlijent_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <md:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="{DynamicResource Btn_AddClient}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- DATAGRID -->
                    <DataGrid x:Name="dgKlijenti"
                          Grid.Row="1"
                          ItemsSource="{Binding Klijenti}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Style="{DynamicResource DataGridBase}"
                          ColumnHeaderStyle="{DynamicResource DataGridHeader}"
                          RowStyle="{DynamicResource DataGridRow}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Margin="15,0">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource PregledKlijenataWindow_Col_Ime}" Binding="{Binding Ime}" Width="*" ElementStyle="{DynamicResource CenterCell}"/>
                            <DataGridTextColumn Header="{DynamicResource PregledKlijenataWindow_Col_Prezime}" Binding="{Binding Prezime}" Width="*" ElementStyle="{DynamicResource CenterCell}"/>
                            <DataGridTextColumn Header="{DynamicResource PregledKlijenataWindow_Col_Telefon}" Binding="{Binding Telefon}" Width="150" ElementStyle="{DynamicResource CenterCell}"/>
                            <DataGridTextColumn Header="{DynamicResource PregledKlijenataWindow_Col_Email}" Binding="{Binding Email}" Width="200" ElementStyle="{DynamicResource CenterCell}"/>
                            <DataGridTextColumn Header="{DynamicResource PregledKlijenataWindow_Col_BrojNarudzbi}" Binding="{Binding BrojNarudzbi}" Width="120" ElementStyle="{DynamicResource CenterCell}"/>

                            <DataGridTemplateColumn Header="{DynamicResource PregledKlijenataWindow_Col_Akcije}" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="110" Height="32"
                                            Margin="5"
                                            Foreground="White"
                                            Tag="{Binding Id}"
                                            Click="BtnDetalji_Click"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Style="{DynamicResource AppPrimaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <md:PackIcon Kind="AccountDetails" Width="20" Height="20" Margin="0,0,6,0" Foreground="White"/>
                                                <TextBlock Text="{DynamicResource PregledKlijenataWindow_Button_Detalji}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>


                    <!-- Zatvori dugme -->
                    <Button Content="{DynamicResource Btn_Close}"
                        Grid.Row="2"
                        Width="110" Height="40"
                        HorizontalAlignment="Right"
                        Style="{DynamicResource AppPrimaryButtonStyle}"
                        Click="Close_Click"
                        Margin="0,15"/>
                </Grid>
            </Border>

            <!-- Snackbar -->
            <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,25"
                                 MessageQueue="{Binding SnackbarQueue}"
                                 Width="450"/>
        </Grid>
    </materialDesign:DialogHost>
</Window>
