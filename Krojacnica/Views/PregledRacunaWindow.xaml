<Window x:Class="Krojacnica.Views.PregledRacunaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource RacuniOverview_Title}"
        Height="750" Width="880"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Grid Background="{DynamicResource AppGradientBrush}">
        <!-- Card panel -->
        <Border Style="{DynamicResource AppCardStyle}" Margin="38,16,38,56" Name="CardBorder">
            <StackPanel>

                <!-- Naslov -->
                <TextBlock Text="{DynamicResource RacuniOverview_Header}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Info sekcija -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,15,0">
                        <TextBlock Text="{DynamicResource RacuniOverview_BrojRacuna}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BrojRacuna}" FontSize="14" Margin="0,2,0,10"/>

                        <TextBlock Text="{DynamicResource RacuniOverview_Datum}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DatumIzdavanja}" FontSize="14" Margin="0,2,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <TextBlock Text="{DynamicResource RacuniOverview_UkupanIznos}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding UkupanIznos}" FontSize="14" Margin="0,2,0,10"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid stavki -->
                <DataGrid x:Name="dgStavke"
                          ItemsSource="{Binding Stavke}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MinHeight="350"
                          HeadersVisibility="Column"
                          AlternationCount="2"
                          HorizontalScrollBarVisibility="Hidden"
                          Style="{DynamicResource DataGridBase}">

                    <DataGrid.ColumnHeaderStyle>
                        <StaticResource ResourceKey="DataGridHeader"/>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <StaticResource ResourceKey="DataGridRow"/>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource RacuniOverview_ColumnNaziv}" Binding="{Binding Naziv}" Width="*" ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource RacuniOverview_ColumnTip}" Binding="{Binding Tip}" Width="120" ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource RacuniOverview_ColumnKolicina}" Binding="{Binding Kolicina}" Width="120" ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource RacuniOverview_ColumnCijena}" Binding="{Binding Cijena}" Width="140" ElementStyle="{DynamicResource CenterCell}"/>
                        <DataGridTextColumn Header="{DynamicResource RacuniOverview_ColumnUkupno}" Binding="{Binding Ukupno, StringFormat={}{0:0.00}}" Width="140" ElementStyle="{DynamicResource CenterCell}"/>
                    </DataGrid.Columns>
                </DataGrid>

                

                <!-- Dugme Zatvori -->
                <Button Content="{DynamicResource RacuniOverview_CloseButton}"
                        Width="120" Height="40"
                        HorizontalAlignment="Right"
                        Style="{DynamicResource AppPrimaryButtonStyle}"
                        Margin="0,15,0,0"
                        Click="BtnZatvori_Click"/>
            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="450"/>
    </Grid>
</Window>
