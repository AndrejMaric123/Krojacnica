<Window x:Class="Krojacnica.Views.ColorsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:vm="clr-namespace:Krojacnica.ViewModels"
        Title="{DynamicResource ColorsManager_Title}"
        Height="630" Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Background="{StaticResource AppGradientBrush}">

        <!-- CARD PANEL -->
        <Border x:Name="CardBorder"
                Style="{StaticResource AppCardStyle}"
                Margin="15"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch">

            <StackPanel>

                <!-- Naslov -->
                <TextBlock Text="{DynamicResource ColorsManager_Title}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppHeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Search + Button -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Width="300" Height="50"
                             Style="{StaticResource AppTextBoxStyle}"
                             materialDesign:HintAssist.Hint="{DynamicResource ColorsManager_SearchHint}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,10,0"/>

                    <Button Content="{DynamicResource ColorsManager_AddColor}"
                            Width="170"
                            Style="{StaticResource AppPrimaryButtonStyle}"
                            Click="AddColor_Click"/>
                </StackPanel>

                <!-- DATAGRID -->
                <DataGrid ItemsSource="{Binding BojeView}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MinHeight="300"
                          AlternationCount="2"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          HorizontalScrollBarVisibility="Hidden"
                          Style="{StaticResource DataGridBase}">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource DataGridHeader}"/>
                        <Style TargetType="DataGridRow"
                               BasedOn="{StaticResource DataGridRow}"/>
                        <Style x:Key="CenterCell"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource CenterCell}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="{DynamicResource ColorsManager_Name}"
                                            Binding="{Binding Naziv}"
                                            Width="2*"
                                            ElementStyle="{StaticResource CenterCell}"/>

                        <DataGridTextColumn Header="{DynamicResource ColorsManager_HexCode}"
                                            Binding="{Binding HexCode}"
                                            Width="*"
                                            ElementStyle="{StaticResource CenterCell}"/>

                        <DataGridTemplateColumn Header="{DynamicResource ColorsManager_Color}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="80" Height="24"
                                            Background="{Binding PreviewBrush}"
                                            CornerRadius="5"
                                            HorizontalAlignment="Center"
                                            BorderBrush="#555"
                                            BorderThickness="1"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{DynamicResource ColorsManager_Actions}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Button Width="45" Height="30"
                                                Margin="4"
                                                Background="#E53935"
                                                Click="Delete_Click"
                                                Style="{StaticResource AppPrimaryButtonStyle}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="12"/>
                                                </Style>
                                            </Button.Resources>
                                            <md:PackIcon Kind="TrashCan" Foreground="White"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- ZATVORI -->
                <Button Content="{DynamicResource ColorsManager_Close}"
                        Width="120"
                        Style="{StaticResource AppPrimaryButtonStyle}"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0"
                        Click="Close_Click"/>

            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <materialDesign:Snackbar x:Name="SnackbarHost"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"
                                 Width="450"/>
    </Grid>
</Window>
